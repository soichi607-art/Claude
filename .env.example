# ---- SoA EDM Studio (.env は Git に含めない) ----
SOA_HOST=127.0.0.1          # LAN公開は 0.0.0.0（その場合 SOA_AUTH_USER/PASSWORD 必須）
SOA_PORT=8000
SOA_SECRET_KEY=             # 空なら data/.secret_key を自動生成
SOA_AUTH_USER=
SOA_AUTH_PASSWORD=
SOA_DATA_DIR=               # 既定 ./data
SOA_MAX_UPLOAD_MB=200
SOA_CPU_THREADS=0           # 0=論理コアの半分
SOA_MIN_FREE_DISK_GB=5
SOA_MIN_FREE_MEM_GB=2
SOA_MAX_TEMP_C=90
SOA_STOP_ON_BATTERY=true
SOA_REST_BETWEEN_CANDIDATES_S=60
SOA_VIDEO_ENCODER=auto      # auto | h264_qsv | libx264
SOA_FONT_PATH=              # 欧文フォント (.ttf) 未設定なら自動検出
SOA_FONT_PATH_JA=           # 日本語フォント (.ttf/.ttc) 未設定なら自動検出
# ---- ACE-Step 1.5 (別プロセスで起動; docs/ACESTEP_SETUP.md) ----
ACESTEP_DIR=                # 例 C:\ACE-Step-1.5
ACESTEP_API_URL=http://127.0.0.1:8001
ACESTEP_API_KEY=            # サーバー側 ACESTEP_API_KEY と同じ値（未設定なら認証なし）
